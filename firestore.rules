rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== FUNÇÕES AUXILIARES ====================

    // Verifica se o usuário está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica se é o próprio usuário
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Campos de /users e /userProfiles que DECIDEM privilégio: isAdmin(),
    // hasResidenciaEditPermission() e getUserType() consultam justamente estes
    // docs. Se o próprio usuário puder escrevê-los, ele se concede o que a
    // regra vai ler depois — escalada de privilégio. Só admin grava (o caminho
    // real é Centro de Gestão > Usuários > Permissões).
    function privilegedUserFields() {
      return [
        'isAdmin', 'isCoordenador', 'role', 'tipoUsuario',
        'permissions', 'customPermissions', 'cardPermissions',
        'documentCategoryPermissions', 'documentIndividualPermissions',
        'documentWritePermissions'
      ];
    }

    function touchesPrivilegedUserFields() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasAny(privilegedUserFields());
    }

    // Verifica se é admin
    function isAdmin() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrador' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Administrador' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Coordenador')) ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.isAdmin == true)
      );
    }

    // Verifica se usuário tem permissão de escrita para documentos
    function hasDocumentWritePermission(category, action) {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.documentWritePermissions != null && (
           (action == 'create' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.documentWritePermissions['doc-create'] == true) ||
           (action == 'edit' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.documentWritePermissions['doc-edit'] == true) ||
           (action == 'delete' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.documentWritePermissions['doc-delete'] == true) ||
           (category != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.documentWritePermissions['doc-' + action + '-' + category] == true)
         )
        )
      );
    }

    // ==================== COMUNICADOS ====================

    match /comunicados/{comunicadoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== DOCUMENTOS ====================

    match /documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== FUNCIONALIDADES (OPCIONAL) ====================

    match /funcionalidades/{funcionalidadeId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== PERFIS DE USUÁRIOS ====================

    match /userProfiles/{userId} {
      allow read: if isAuthenticated();

      // Admin (Centro de Gestão) é o único caminho para cargo e permissões.
      allow write: if isAdmin();

      // Primeiro login cria o próprio perfil, mas só na forma sem privilégio
      // (colaborador). Quem já foi promovido no Centro de Gestão não passa por
      // aqui: o admin já criou o doc, então a branch é update, não create.
      allow create: if isOwner(userId)
        && request.resource.data.get('isAdmin', false) == false
        && request.resource.data.get('isCoordenador', false) == false
        && request.resource.data.get('role', 'colaborador') == 'colaborador'
        && request.resource.data.get('permissions', {}).keys().hasOnly(['doc-protocolos'])
        && !request.resource.data.keys().hasAny([
             'tipoUsuario', 'customPermissions', 'cardPermissions',
             'documentCategoryPermissions', 'documentIndividualPermissions',
             'documentWritePermissions'
           ]);

      // Edição do próprio perfil (nome, avatar, CRM, consentimento LGPD).
      allow update: if isOwner(userId) && !touchesPrivilegedUserFields();
    }

    // Collection users - gerenciamento de permissões
    match /users/{userId} {
      allow read: if isAuthenticated();

      allow write: if isAdmin();

      // Mesma regra do userProfiles: a lista antiga esquecia 'permissions',
      // 'isAdmin', 'isCoordenador' e 'tipoUsuario' — exatamente os campos que
      // hasResidenciaEditPermission(), isAdmin() e getUserType() leem daqui.
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(privilegedUserFields());
      allow update: if isOwner(userId) && !touchesPrivilegedUserFields();
    }

    // ==================== SUBCOLLECTIONS DE USUÁRIOS ====================

    match /usuarios/{userId}/comunicados_lidos/{comunicadoId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update, delete: if false;
    }

    match /usuarios/{userId}/documentos_visualizados/{documentoId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update, delete: if false;
    }

    match /usuarios/{userId}/funcionalidades_visualizadas/{funcionalidadeId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      allow update, delete: if false;
    }

    // ==================== OUTRAS COLLECTIONS ====================

    match /kpis/{kpiId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /kpi_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /auditorias_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('relatorios', 'create');
    }

    match /relatorios_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('relatorios', 'create');
    }

    match /biblioteca_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('protocolos', 'create');
    }

    match /kpi_adesao_protocolos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /kpi_taxa_infeccao/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /medicamentos_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /infeccao_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /conciliacao_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /checklist_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /auditorias_evidencias/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /comunicadosInternos/{comunicadoId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ==================== EMAILS AUTORIZADOS ====================

    match /authorized_emails/{emailId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== DOCUMENTOS POR CATEGORIA ====================

    match /auditoria_higiene_maos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('protocolos', 'create');
    }

    match /auditoria_uso_medicamentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('protocolos', 'create');
    }

    match /auditoria_abreviaturas/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('protocolos', 'create');
    }

    match /politica_gestao_qualidade/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('politicas', 'create');
    }

    match /politica_disclosure/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('politicas', 'create');
    }

    match /relatorio_trimestral/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('relatorios', 'create');
    }

    match /relatorio_incidentes/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('relatorios', 'create');
    }

    match /relatorio_auditorias/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('relatorios', 'create');
    }

    match /relatorio_indicadores/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin() || hasDocumentWritePermission('relatorios', 'create');
    }

    match /doc_mav/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /doc_eletrolitos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /doc_heparina/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /doc_narcoticos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /doc_lista_abreviaturas/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /doc_intoxicacao_anestesicos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /doc_manejo_glicemia/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_higiene_maos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_prevencao_isc/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_prevencao_ics/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_prevencao_pav/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_prevencao_itu/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_prevencao_broncoaspiracao/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_prevencao_alergia_latex/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /conciliacao_admissao/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /conciliacao_transferencia/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /conciliacao_alta/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /protocolo_institucional/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /checklist_cirurgia/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /desastres_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /organograma_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== ÉTICA E BIOÉTICA ====================

    match /etica_dilemas_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /etica_parecer_uti_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /etica_diretrizes_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /etica_parecer_tecnico_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /etica_codigo_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== INCIDENTES E DENÚNCIAS ====================

    match /incidentes/{incidenteId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /denuncias/{denunciaId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // ==================== COMITÊS ====================

    match /comites_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== CONFIGURAÇÕES DO SISTEMA ====================

    match /configuracoes/{configId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ==================== EDUCAÇÃO CONTINUADA (STUDENT-SAFE) ====================

    function getUserType() {
      return (request.auth.token.userType != null)
        ? request.auth.token.userType
        : (exists(/databases/$(database)/documents/users/$(request.auth.uid))
          ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipoUsuario
          : (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid))
            ? get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.tipoUsuario
            : null));
    }

    function canAccessEducacaoEntity(entity) {
      let userType = getUserType();
      return (!('effectiveVisibility' in entity)
          || entity.effectiveVisibility == null
          || entity.effectiveVisibility == 'PUBLIC')
        ? true
        : (entity.effectiveVisibility == 'RESTRICTED'
          ? (userType != null && userType in entity.effectiveAllowedUserTypes)
          : false);
    }

    function isCursoPublishedAndAccessible(cursoId) {
      let curso = get(/databases/$(database)/documents/educacao_cursos/$(cursoId));
      return curso != null
        && curso.data.ativo == true
        && (curso.data.statusPublicacao == 'published'
            || curso.data.status == 'PUBLISHED')
        && canAccessEducacaoEntity(curso.data);
    }

    match /educacao_trilhas/{trilhaId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated()
        && (resource.data.statusPublicacao == 'published'
            || resource.data.status == 'PUBLISHED')
        && resource.data.ativo == true
        && canAccessEducacaoEntity(resource.data);
    }

    match /educacao_cursos/{cursoId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated()
        && (resource.data.statusPublicacao == 'published'
            || resource.data.status == 'PUBLISHED')
        && resource.data.ativo == true
        && canAccessEducacaoEntity(resource.data);
    }

    match /educacao_modulos/{moduloId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated()
        && resource.data.ativo == true
        && (resource.data.statusPublicacao == 'published'
            || resource.data.status == 'PUBLISHED')
        && resource.data.cursoId != null
        && isCursoPublishedAndAccessible(resource.data.cursoId);
    }

    match /educacao_aulas/{aulaId} {
      allow read, write: if isAdmin();
      allow read: if isAuthenticated()
        && resource.data.ativo == true
        && (resource.data.statusPublicacao == 'published'
            || resource.data.status == 'PUBLISHED')
        && resource.data.moduloId != null
        && get(/databases/$(database)/documents/educacao_modulos/$(resource.data.moduloId)).data.ativo == true
        && (get(/databases/$(database)/documents/educacao_modulos/$(resource.data.moduloId)).data.statusPublicacao == 'published'
            || get(/databases/$(database)/documents/educacao_modulos/$(resource.data.moduloId)).data.status == 'PUBLISHED')
        && get(/databases/$(database)/documents/educacao_modulos/$(resource.data.moduloId)).data.cursoId != null
        && isCursoPublishedAndAccessible(get(/databases/$(database)/documents/educacao_modulos/$(resource.data.moduloId)).data.cursoId);
    }

    match /educacao_trilha_cursos/{relId} {
      allow read, write: if isAdmin();
    }

    match /educacao_curso_modulos/{relId} {
      allow read, write: if isAdmin();
    }

    match /educacao_modulo_aulas/{relId} {
      allow read, write: if isAdmin();
    }

    match /educacao_categorias/{categoriaId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // LGPD (Art. 18 — eliminação): admin tem `delete` para processar
    // solicitações de exclusão via lgpdService.processSolicitacao.
    match /educacao_progresso/{userId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read, delete: if isAdmin();
    }

    match /educacao_progresso/{userId}/cursos/{cursoId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read, delete: if isAdmin();
    }

    match /educacao_progresso/{userId}/trilhas/{trilhaId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read, delete: if isAdmin();
    }

    match /educacao_progresso/{userId}/estatisticas/{docId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read, delete: if isAdmin();
    }

    match /educacao_progresso/{userId}/tracking_sessions/{sessionId} {
      allow read, write: if isAuthenticated() && isOwner(userId);
      allow read, delete: if isAdmin();
    }

    // Tentativas de quiz (subcoleção de educacao_cursos). Não havia match
    // explícito — a regra catch-all negava tudo. LGPD hardening Fase 2:
    //   - create: usuário autenticado grava apenas tentativa própria
    //     (salvarQuizTentativa em educacaoService.js)
    //   - read: dono da tentativa ou admin (getQuizTentativas / relatórios)
    //   - delete: admin (lgpdService.processSolicitacao — exclusão do titular)
    //   - update: ninguém (tentativa é registro imutável)
    match /educacao_cursos/{cursoId}/tentativas/{tentativaId} {
      allow read: if isAuthenticated()
        && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /educacao_certificados/{certificadoId} {
      // Wave 1.7 (LGPD): leitura PÚBLICA removida. A verificação /verificar/:uuid
      // agora vai pela edge function `verify-cert-uuid-public`, que usa
      // service account (Cloud Datastore User) e devolve apenas iniciais +
      // metadados não-PII. Service account NÃO passa por estas regras —
      // ela faz REST direto na Firestore Admin API.
      allow read: if isAuthenticated() && (
        resource.data.userId == request.auth.uid || isAdmin()
      );
      // User dono pode criar seu próprio certificado (fluxo de emissão pós-curso).
      allow create: if isAuthenticated()
        && request.resource.data.userId == request.auth.uid;
      // Apenas admin atualiza/revoga ou deleta. Deleção pelo lgpdService
      // (admin context) também é aceita aqui.
      allow update, delete: if isAdmin();
    }

    match /educacao_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if false;
    }

    // T1.5.13 — Advisory edit locks (co-autoria leve para admin de educação).
    // Qualquer admin pode ler/escrever; check ownership do lock é client-side
    // (advisory, não enforced). Doc ID = `${resourceType}_${resourceId}`.
    match /educacao_edit_locks/{lockId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // T1.5.14 — Histórico de bulk imports (snapshot + rollback até 24h).
    // Doc é escrito pela Cloud Function `importQuestionsJsonl` via firebase-admin
    // (bypassa rules), mas leitura precisa ser permitida pra UI mostrar history.
    match /educacao_import_history/{importId} {
      allow read: if isAdmin();
      // Writes acontecem via Cloud Function com firebase-admin SDK (bypass).
      allow create, update, delete: if false;
    }

    // ==================== RESIDÊNCIA MÉDICA ====================

    function hasResidenciaEditPermission() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions != null &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions['residencia-edit'] == true) ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions != null &&
         get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.permissions['residencia-edit'] == true)
      );
    }

    match /residencia/{docId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasResidenciaEditPermission();
    }

    // Overrides de estágios por slot (data+turno) — cirurgiões e ajustes pontuais
    match /residenciaEstagiosDiarios/{slotKey} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasResidenciaEditPermission();
    }

    // Overrides do plantão por dia — editado por admin/coordenador ou via aceite de troca
    match /residenciaPlantaoDiario/{dateKey} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Trocas de plantão entre residentes
    match /trocas_plantao/{tradeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ==================== ESCALAS DE FUNCIONÁRIOS ====================

    function hasEscalasEditPermission() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions != null &&
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions['escalas-edit'] == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions['residencia-edit'] == true))
      );
    }

    function hasStaffEditPermission() {
      return isAuthenticated() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
         (get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('isCoordenador', false) == true ||
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'administrador' ||
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'Administrador' ||
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'coordenador' ||
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('role', '') == 'Coordenador' ||
          get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('permissions', {}).get('tec-enf-secretaria-edit', false) == true))
      );
    }

    // Atestado acompanha a edicao da escala (dono 01/09): quem edita as escalas de
    // tecnicas/secretarias tambem gerencia afastamento. A permissao dedicada segue
    // valendo sozinha, para o perfil de RH que nao edita a escala operacional.
    // O dado continua isolado nesta colecao — `validPublicStaffSchedule` segue
    // recusando a chave `atestado` no doc publico /staff/schedule.
    function hasStaffAbsencePrivatePermission() {
      return hasStaffEditPermission() || (
        isAuthenticated() &&
        exists(/databases/$(database)/documents/userProfiles/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.get('permissions', {}).get('staff-absence-private', false) == true
      );
    }

    function validPublicStaffSchedule(data) {
      return data.keys().hasOnly([
          'hospitais', 'consultorio', 'staffCatalog',
          'hospitaisCardData', 'hospitaisCardTurno',
          'consultorioCardData', 'consultorioCardTurno',
          'revision', 'updatedAt', 'updatedBy'
        ]) &&
        data.get('hospitais', {}).keys().hasOnly([
          'hro', 'unimed', 'materno', 'ferias', 'indisponivel'
        ]) &&
        data.get('consultorio', {}).keys().hasOnly([
          'volanFinanceiro', 'administrativo', 'recepcao',
          'telefoneWhatsapp', 'financeiro', 'enfermagemQmentum',
          'ferias', 'indisponivel'
        ]) &&
        data.get('staffCatalog', []) is list &&
        data.revision is int && data.revision >= 1 &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt == request.time;
    }

    function validPreviousStaffAssignment(data) {
      return !data.keys().hasAny(['previousAssignment']) ||
        (data.previousAssignment is map &&
         data.previousAssignment.keys().hasOnly(['sectionKey', 'turno', 'funcoes']) &&
         data.previousAssignment.get('sectionKey', '') is string &&
         ((data.scope == 'hospitais' && data.previousAssignment.sectionKey in [
            'hro', 'unimed', 'materno', 'ferias'
          ]) ||
          (data.scope == 'consultorio' && data.previousAssignment.sectionKey in [
            'volanFinanceiro', 'administrativo', 'recepcao',
            'telefoneWhatsapp', 'financeiro', 'enfermagemQmentum', 'ferias'
          ])) &&
         data.previousAssignment.get('turno', '') is string &&
         data.previousAssignment.get('turno', '').size() <= 80 &&
         data.previousAssignment.get('funcoes', '') is string &&
         data.previousAssignment.get('funcoes', '').size() <= 120);
    }

    function validStaffMedicalLeave(data) {
      return data.keys().hasOnly([
          'scope', 'employeeName', 'kind', 'startsAt', 'endsAt',
          'status', 'source', 'previousAssignment',
          'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]) &&
        data.keys().hasAll([
          'scope', 'employeeName', 'kind', 'startsAt', 'endsAt',
          'status', 'source', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'
        ]) &&
        data.scope in ['hospitais', 'consultorio'] &&
        data.employeeName is string && data.employeeName.size() > 0 && data.employeeName.size() <= 120 &&
        data.kind == 'medical_leave' &&
        data.startsAt is timestamp && data.endsAt is timestamp && data.endsAt >= data.startsAt &&
        data.status in ['active', 'cancelled'] &&
        data.source in ['manual', 'legacy'] &&
        data.createdBy is string && data.updatedBy is string &&
        data.createdAt is timestamp && data.updatedAt is timestamp &&
        validPreviousStaffAssignment(data);
    }

    match /staff/{docId} {
      allow read: if isAuthenticated();
      allow create: if docId == 'schedule' &&
        hasStaffEditPermission() &&
        request.resource.data.revision == 1 &&
        request.resource.data.hospitais.get('indisponivel', []) is list &&
        request.resource.data.hospitais.get('indisponivel', []).size() == 0 &&
        request.resource.data.consultorio.get('indisponivel', []) is list &&
        request.resource.data.consultorio.get('indisponivel', []).size() == 0 &&
        validPublicStaffSchedule(request.resource.data);
      allow update: if docId == 'schedule' &&
        hasStaffEditPermission() &&
        !resource.data.get('hospitais', {}).keys().hasAny(['atestado']) &&
        !resource.data.get('consultorio', {}).keys().hasAny(['atestado']) &&
        request.resource.data.revision == resource.data.get('revision', 0) + 1 &&
        request.resource.data.hospitais.get('indisponivel', []) == resource.data.hospitais.get('indisponivel', []) &&
        request.resource.data.consultorio.get('indisponivel', []) == resource.data.consultorio.get('indisponivel', []) &&
        validPublicStaffSchedule(request.resource.data);
      allow delete: if false;
    }

    match /staffMedicalLeaves/{leaveId} {
      allow read: if hasStaffAbsencePrivatePermission();
      allow create: if hasStaffAbsencePrivatePermission() &&
        validStaffMedicalLeave(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.createdAt == request.time &&
        request.resource.data.updatedAt == request.time;
      allow update: if hasStaffAbsencePrivatePermission() &&
        validStaffMedicalLeave(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'startsAt', 'endsAt', 'status', 'updatedAt', 'updatedBy'
        ]) &&
        request.resource.data.updatedBy == request.auth.uid &&
        request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    // Base MENSAL das escalas das funcionárias (sobreaviso + hospitais),
    // publicada pelo import in-app — substitui o mês inteiro dos data files
    // estáticos. Write restrito: reescreve a escala de um mês INTEIRO.
    match /escalasFuncionarias/{mes} {
      allow read: if isAuthenticated();
      allow create, update, delete: if hasEscalasEditPermission() && mes.matches('^[0-9]{4}-[0-9]{2}$');
    }

    // Overrides do sobreaviso materno por dia — editado por admin/coordenador ou via aceite de troca
    match /sobreavisoMaternoDiario/{dateKey} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Trocas de sobreaviso materno entre funcionárias
    match /trocas_sobreaviso/{tradeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Trocas de plantão hospitalar (FDS/feriados) entre funcionárias
    match /trocas_plantao_hospitalar/{tradeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Overrides de plantão hospitalar por dia/hospital/turno (HRO/UNIMED/Plantão Pago)
    match /hospitaisDiario/{slotKey} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Trocas de FERIADO entre anestesistas (fila única do feriado, escala numérica).
    // Sem coleção de override: a troca aceita É o fato e a tela a aplica na leitura, então
    // este bloco é o único que governa o assunto. Delete continua só do admin — recusar ou
    // cancelar é mudança de status, nunca apagar o histórico.
    match /trocas_feriado/{tradeId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // ==================== GESTÃO DE REUNIÕES ====================

    // Reuniões — admin/organizador livre; participante pode alterar apenas campos próprios
    match /reunioes/{reuniaoId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated();

      // Update em 3 cenários:
      //   1) admin (papel administrativo) — livre
      //   2) organizador (createdBy) — livre
      //   3) participante (uid em participantesIds) — restrito aos campos próprios
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == resource.data.createdBy ||
        (
          resource.data.participantesIds is list &&
          request.auth.uid in resource.data.participantesIds &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['presentes', 'faltantes', 'justificativasFaltas', 'checkins', 'updatedAt'])
        )
      );

      allow delete: if isAuthenticated() && (
        isAdmin() || request.auth.uid == resource.data.createdBy
      );
    }

    // Documentos de reuniões (subsídios, pautas, atas) — qualquer autenticado cria; admin ou uploader edita/deleta
    match /reuniao_documentos/{documentoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin() || request.auth.uid == resource.data.uploadedBy;
    }

    // Histórico de status das reuniões
    match /reuniao_status_historico/{historicoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // Notificações de reuniões
    match /reuniao_notifications/{notifId} {
      // Usuário só lê as próprias notificações; admin lê tudo
      allow read: if isAuthenticated() && (
        isAdmin() || resource.data.userId == request.auth.uid
      );

      // Organizador/admin cria notificações para participantes
      allow create: if isAuthenticated();

      // Usuário pode atualizar (marcar como lida) só as suas próprias
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Admin pode deletar para limpeza
      allow delete: if isAdmin();
    }

    match /reuniao_participantes/{participanteId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // Deliberações e votações de reuniões
    match /reuniao_deliberacoes/{deliberacaoId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['votos', 'votosAnonimos', 'votantesHash', 'resultado', 'updatedAt', 'status', 'closedAt', 'closedBy'])
      );
      allow delete: if isAdmin();
    }

    // Regra padrão: negar tudo que não foi especificado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
