# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_JWT_SECRET=

# PegaPlantao API (OAuth2)
VITE_PEGAPLANTAO_CLIENT_ID=
VITE_PEGAPLANTAO_CLIENT_SECRET=
VITE_PEGAPLANTAO_USERNAME=
VITE_PEGAPLANTAO_PASSWORD=

# Onda 1 — DMS validadas (default false em prod até validação manual)
VITE_FEATURE_HASH_SIGNATURE=false
VITE_FEATURE_WATERMARK=false
VITE_FEATURE_RETENTION=false
VITE_FEATURE_CONFIDENTIALITY=false
VITE_FEATURE_MULTI_STEP_APPROVAL=false

# Sprint 4 / Onda 2 — O2-2 OCR Tesseract WASM client-side (PDFs escaneados)
VITE_FEATURE_OCR=false

# Sprint 5 / Onda 2 — O2-4 Bulk import (drag-drop massa de PDFs, admin only)
VITE_FEATURE_BULK_IMPORT=false

# Sprint 19 — Sentry observability (free tier 5k events/mês). Sem DSN, app
# usa fallback Firebase Analytics. Obter em sentry.io → New project → React.
VITE_SENTRY_DSN=

# Sprint 21 / Wave 2.2 — Web Push (Firebase Cloud Messaging).
# Obter em Firebase Console → Project Settings → Cloud Messaging → Web
# configuration → Web Push certificates → "Generate key pair".
# Sem essa chave o app degrada gracefully (push fica desabilitado, in-app
# notifications continuam funcionando).
VITE_FIREBASE_VAPID_KEY=

# ── MCP Servers (Claude Code) ──────────────────────────────────────
# Estas vars são consumidas pelos MCP servers do Claude Code, não pelo Vite.
# Setar via `export VAR=value` no ~/.zshrc ou no terminal antes de abrir Claude Code.

# Firecrawl — web scraping/crawling (free tier: 1000 credits/mês)
# Obter em: https://www.firecrawl.dev/app/api-keys
FIRECRAWL_API_KEY=

# Supabase MCP — acesso direto ao projeto Supabase via Claude Code
# Obter em: https://supabase.com/dashboard/account/tokens (Personal Access Token)
SUPABASE_ACCESS_TOKEN=