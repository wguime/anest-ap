# Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_JWT_SECRET=

# PegaPlantao API (OAuth2)
VITE_PEGAPLANTAO_CLIENT_ID=
VITE_PEGAPLANTAO_CLIENT_SECRET=
VITE_PEGAPLANTAO_USERNAME=
VITE_PEGAPLANTAO_PASSWORD=

# UpToDate Integration (NÃO entram no client — apenas em GitHub Secrets / Supabase secrets)
#   GitHub Secrets (Settings → Secrets → Actions):
#     UPTODATE_EMAIL          = login UpToDate (consumido pelo workflow uptodate-weekly.yml)
#     UPTODATE_PASSWORD       = senha UpToDate (idem)
#     INGEST_UPTODATE_URL     = https://<ref>.supabase.co/functions/v1/ingest-uptodate
#     INGEST_UPTODATE_SECRET  = openssl rand -hex 32 (mesmo valor no Supabase)
#   Supabase Edge Function secrets (npx supabase secrets set ...):
#     INGEST_UPTODATE_SECRET  = mesmo valor acima (autentica HMAC do payload)
