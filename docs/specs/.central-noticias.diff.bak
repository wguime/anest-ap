+      {isResumoUtil(resumo) ? (
+        <div className="flex flex-col gap-4">
+          <AbstractBody resumo={resumo} />
+          {showOriginalResumo && (
+            <details className="text-[13px] text-muted-foreground border-t border-border pt-4">
+              <summary className="cursor-pointer hover:text-foreground transition-colors font-medium select-none">
+                Ver texto original
+              </summary>
+              <div className="mt-3 italic">
+                <AbstractBody resumo={noticia.resumo} muted />
+              </div>
+            </details>
+          )}
+        </div>
