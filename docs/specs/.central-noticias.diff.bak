+function parsePubmedXml(xml: string): PubmedArticle[] {
+  const articles = parseXmlFieldAll(xml, 'PubmedArticle')
+  return articles.map((art) => {
+    const pmid = parseXmlFieldAll(art, 'PMID')[0] || ''
+    const doiArr = parseXmlFieldAll(art, 'ArticleId').filter((s) => /^10\.\d{4,}/i.test(stripXmlText(s)))
+    // Filtra ArticleId com IdType="doi"
+    const doiMatch = art.match(/<ArticleId[^>]*IdType="doi"[^>]*>([\s\S]*?)<\/ArticleId>/i)
+    const doi = doiMatch ? stripXmlText(doiMatch[1]).toLowerCase() : (doiArr[0] ? stripXmlText(doiArr[0]).toLowerCase() : null)
+    const titleRaw = parseXmlFieldAll(art, 'ArticleTitle')[0] || ''
+    const title = stripXmlText(titleRaw)
+    const abstractParts = parseXmlFieldAll(art, 'AbstractText')
+    const abstract = abstractParts.length > 0 ? stripXmlText(abstractParts.join(' ')) : null
+
+    // Autores: <AuthorList>...<Author>...<LastName>X</LastName><ForeName>Y</ForeName>...</Author>
+    const authorBlocks = parseXmlFieldAll(art, 'Author')
