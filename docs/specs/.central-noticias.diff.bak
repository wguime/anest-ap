+// ─────────────── Crossref (citation_count opcional) ───────────────
+
+async function crossrefCitationCount(doi: string): Promise<number | null> {
+  if (!doi) return null
+  try {
+    const url = `https://api.crossref.org/works/${encodeURIComponent(doi)}`
+    const ctrl = new AbortController()
+    const timer = setTimeout(() => ctrl.abort(), 12_000)
+    try {
+      const res = await fetch(url, {
+        signal: ctrl.signal,
+        headers: { 'User-Agent': 'ANEST-NewsBot/2.0 (mailto:wguime@yahoo.com.br)', Accept: 'application/json' },
+      })
+      if (!res.ok) return null
+      const data = await res.json()
+      const c = data?.message?.['is-referenced-by-count']
+      return typeof c === 'number' ? c : null
+    } finally {
+      clearTimeout(timer)
+    }
+  } catch {
+    return null
+  }
 }
 
