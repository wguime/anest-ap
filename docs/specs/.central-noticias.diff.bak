   // Also clear any stuck overflow:hidden on body (safety net for modals that didn't clean up)
   useEffect(() => {
     document.body.style.overflow = ''
+    document.body.style.position = ''
+    document.documentElement.style.overflow = ''
     window.scrollTo({ top: 0, left: 0, behavior: 'instant' })
     trackPageView(currentPage)
   }, [currentPage, trackPageView])
 
+  // Watchdog global: se algo setar body/html overflow=hidden sem nenhum Modal
+  // do DS aberto (.modal-safe na DOM) ou PDFViewer fullscreen, desfaz.
+  // Resolve casos onde HMR/erro deixou body travado entre reloads.
+  useEffect(() => {
+    const cleanIfStuck = () => {
+      const realModalOpen =
+        document.querySelector('.modal-safe') ||
+        document.querySelector('[data-slot="anest-modal"]') ||
+        document.querySelector('[data-fullscreen-pdf="true"]')
+      if (realModalOpen) return
+      if (document.body.style.overflow === 'hidden') {
+        document.body.style.overflow = ''
+      }
+      if (document.documentElement.style.overflow === 'hidden') {
+        document.documentElement.style.overflow = ''
+      }
+    }
+    cleanIfStuck()
+    const observer = new MutationObserver(cleanIfStuck)
+    observer.observe(document.body, { attributes: true, attributeFilter: ['style'] })
+    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['style'] })
+    return () => observer.disconnect()
+  }, [])
+
   // BUG-04 fix: Reset state when unauthenticated (moved out of render to avoid state updates during render)
   // Public pages that don't require authentication
   const PUBLIC_PAGES = ['home', 'verificarCertificado'];
