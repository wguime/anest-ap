-              >
-                <ExternalLink className="w-4 h-4" />
-                Ler na fonte original
-              </Button>
-            </div>
+// ────────────────── AbstractBody: estruturado ou corrido ──────────────────
 
-            {/* Fontes extras */}
-            {Array.isArray(noticia.fontesExtras) && noticia.fontesExtras.length > 0 && (
-              <div className="mt-2">
