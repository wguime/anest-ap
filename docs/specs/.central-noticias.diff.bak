+          {titulo}
+        </h2>
+        {showOriginalTitle && (
+          <p className="mt-3 text-[13px] italic leading-snug text-muted-foreground">
+            {noticia.titulo}
+          </p>
+        )}
+        {noticia.autores && (
+          <div className="flex items-start gap-2 mt-4 pt-4 border-t border-border text-[13px] text-muted-foreground">
+            <User className="w-4 h-4 mt-0.5 shrink-0" aria-hidden="true" />
+            <p>{noticia.autores}</p>
+          </div>
+        )}
+      </header>
+
+      {/* Corpo: abstract estruturado (BACKGROUND/METHODS/RESULTS/CONCLUSIONS)
