-                  Também publicado em:
-                </p>
-                <div className="flex flex-wrap gap-2">
-                  {noticia.fontesExtras.map((f, idx) => (
-                    <button
-                      key={`${f.fonte}-${idx}`}
-                      type="button"
-                      onClick={() => handleOpenSource(f.url)}
-                      className="inline-flex items-center gap-1 px-3 h-8 min-h-[32px] rounded-full border border-border bg-card text-[12px] font-medium text-foreground hover:bg-accent/40 transition-colors"
-                    >
-                      {f.fonte}
-                      <ExternalLink className="w-3 h-3" aria-hidden="true" />
-                    </button>
-                  ))}
-                </div>
-              </div>
-            )}
-          </motion.article>
-        )}
+function AbstractBody({ resumo, muted = false }) {
+  const sections = parseStructuredAbstract(resumo)
+  const colorClass = muted ? 'text-muted-foreground' : 'text-foreground'
+
+  if (sections) {
+    return (
+      <div className="flex flex-col gap-4">
+        {sections.map((s, i) => (
+          <section key={`${s.label}-${i}`} className="space-y-1.5">
+            <h3 className="text-[11px] font-bold uppercase tracking-wider text-muted-foreground">
+              {s.label}
+            </h3>
+            <p
+              className={`text-[16px] leading-[1.75] ${colorClass}`}
+              dangerouslySetInnerHTML={{
+                __html: DOMPurify.sanitize(s.body, { ALLOWED_TAGS: [] }),
+              }}
+            />
+          </section>
+        ))}
       </div>
-    </div>
+    )
+  }
+
+  // Texto corrido (sem rótulos detectados)
+  return (
+    <div
+      className={[
+        'text-[16px] lg:text-[17px]',
+        'leading-[1.75] tracking-[0.005em]',
+        colorClass,
+        '[&_p]:mb-4 [&_p:last-child]:mb-0',
+        'whitespace-pre-line',
+      ].join(' ')}
+      dangerouslySetInnerHTML={{
+        __html: DOMPurify.sanitize(resumo, { ALLOWED_TAGS: [] }),
+      }}
+    />
   )
 }
