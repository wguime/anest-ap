+      .map((b) => {
+        const ln = stripXmlText(parseXmlFieldAll(b, 'LastName')[0] || '')
+        const fn = stripXmlText(parseXmlFieldAll(b, 'ForeName')[0] || '')
+        return `${fn} ${ln}`.trim()
+      })
+      .filter(Boolean)
+      .slice(0, 6)
+      .join(', ')
+    const fullAuthorsCount = authorBlocks.length
+    const authorsStr = fullAuthorsCount > 6 ? `${authors}, et al.` : (authors || null)
+
+    // Data: <PubDate><Year>...</Year><Month>...</Month><Day>...</Day></PubDate>
+    const pubDateBlock = parseXmlFieldAll(art, 'PubDate')[0] || ''
+    const year = stripXmlText(parseXmlFieldAll(pubDateBlock, 'Year')[0] || '')
+    const month = stripXmlText(parseXmlFieldAll(pubDateBlock, 'Month')[0] || '01')
+    const day = stripXmlText(parseXmlFieldAll(pubDateBlock, 'Day')[0] || '01')
+    const monthMap: Record<string, string> = {
+      Jan: '01', Feb: '02', Mar: '03', Apr: '04', May: '05', Jun: '06',
