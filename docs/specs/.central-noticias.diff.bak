+
+    const journalTitle = stripXmlText(parseXmlFieldAll(art, 'Title')[0] || '')
+
+    // MeSH
+    const meshBlocks = parseXmlFieldAll(art, 'MeshHeading')
+    const meshTerms = meshBlocks
+      .map((b) => stripXmlText(parseXmlFieldAll(b, 'DescriptorName')[0] || ''))
+      .filter(Boolean)
+
+    // PublicationType
+    const ptypes = parseXmlFieldAll(art, 'PublicationType').map(stripXmlText).filter(Boolean)
+
+    // Keywords
+    const keywords = parseXmlFieldAll(art, 'Keyword').map(stripXmlText).filter(Boolean)
+
+    return {
+      pmid,
+      doi,
+      title,
+      abstract,
+      authors: authorsStr,
+      publishedAt: isoDate,
+      journalTitle,
+      meshTerms,
+      publicationTypes: ptypes,
+      keywords,
