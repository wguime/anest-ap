+// ─────────────── Parser de abstract estruturado (PubMed) ───────────────
+
+// Rótulos canônicos → título amigável em PT
+const LABEL_PT = {
+  BACKGROUND: 'Introdução',
+  INTRODUCTION: 'Introdução',
+  ANTECEDENTES: 'Introdução',
+  OBJECTIVE: 'Objetivo',
+  OBJECTIVES: 'Objetivo',
+  AIM: 'Objetivo',
+  AIMS: 'Objetivo',
+  PURPOSE: 'Objetivo',
+  OBJETIVO: 'Objetivo',
+  OBJETIVOS: 'Objetivo',
+  METHODS: 'Métodos',
+  'MATERIALS AND METHODS': 'Métodos',
+  'PATIENTS AND METHODS': 'Métodos',
+  'STUDY DESIGN': 'Métodos',
+  DESIGN: 'Métodos',
+  MÉTODOS: 'Métodos',
+  METODOS: 'Métodos',
+  DESENHO: 'Métodos',
+  RESULTS: 'Resultados',
+  FINDINGS: 'Resultados',
+  RESULTADOS: 'Resultados',
+  CONCLUSION: 'Conclusões',
+  CONCLUSIONS: 'Conclusões',
+  INTERPRETATION: 'Conclusões',
+  CONCLUSÕES: 'Conclusões',
+  CONCLUSAO: 'Conclusões',
+  CONCLUSOES: 'Conclusões',
+  DISCUSSION: 'Discussão',
+  DISCUSSÃO: 'Discussão',
+  DISCUSSAO: 'Discussão',
+  IMPLICATIONS: 'Implicações',
+  'CLINICAL IMPLICATIONS': 'Implicações',
+}
+
+// Regex captura LABEL: (com ou sem ponto/colchete antes; precedido por início/quebra/ponto)
+// Exemplos detectados: "BACKGROUND:", "Methods:", "RESULTS :", "Conclusões:"
+const LABEL_REGEX = /(?:^|[\s.;])((?:[A-ZÁÉÍÓÚÃÕÇÂÊÔ][A-ZÁÉÍÓÚÃÕÇÂÊÔ\s]{2,40}))\s*:\s+/g
+
+function parseStructuredAbstract(text) {
+  if (!text || typeof text !== 'string') return null
+  const trimmed = text.trim()
+  if (trimmed.length < 60) return null
+
+  // Encontra todas as ocorrências de "LABEL:" e os offsets
+  const matches = []
+  let m
+  const regex = new RegExp(LABEL_REGEX.source, 'g')
+  while ((m = regex.exec(trimmed)) !== null) {
+    const rawLabel = m[1].trim().toUpperCase()
+    const friendlyLabel = LABEL_PT[rawLabel]
+    if (!friendlyLabel) continue
+    matches.push({
+      labelStart: m.index + m[0].indexOf(m[1]),
+      contentStart: m.index + m[0].length,
+      label: friendlyLabel,
+    })
+  }
+
+  if (matches.length < 2) return null
+
+  // Constrói seções: conteúdo de cada label vai até o próximo labelStart ou fim
+  const sections = matches.map((mm, i) => {
+    const end = i + 1 < matches.length ? matches[i + 1].labelStart : trimmed.length
+    const body = trimmed.slice(mm.contentStart, end).trim()
+    return { label: mm.label, body }
+  }).filter((s) => s.body.length > 0)
+
+  return sections.length >= 2 ? sections : null
 }
 
