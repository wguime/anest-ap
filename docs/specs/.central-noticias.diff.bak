+}
+
+// ────────────────────────── Metadata ──────────────────────────
+
+function MetadataSection({ noticia }) {
+  const items = []
+  if (noticia.category) items.push({ label: 'Categoria', value: noticia.category })
+  if (noticia.articleType) items.push({ label: 'Tipo', value: noticia.articleType })
+  if (typeof noticia.citationCount === 'number' && noticia.citationCount > 0) {
+    items.push({ label: 'Citações', value: String(noticia.citationCount) })
